# =========================================================================
# Unity .gitignore Completo y Optimizado
# =========================================================================

# Carpetas generadas automáticamente por Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset server cache
/[Aa]sset_Server_Cache/

# Archivos de caché y configuración temporal del Editor
*.pid
*.pidb
*.unityproj
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Compilaciones y builds generados
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.zip
*.7z

# Visual Studio & Visual Studio Code & Rider
.vs/
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs

# Unity Profiler / Crash reports
*.crash
*.dmp
*.nvprof

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Unity Plastic SCM / Version Control temporal
.plastic/
.collab/

# Cache de paquetes locales
/Packages/manifest.json.lock
/Packages/packages-lock.json

# =========================================================================
# Modelos pesados y paquetes de la Asset Store (Omitidos del repo)
# =========================================================================
/Assets/AGWYN's Low Poly Magical Potions Pack/
/Assets/AGWYN's Low Poly Magical Potions Pack.meta
/Assets/Low Poly Weapons VOL.1/
/Assets/Low Poly Weapons VOL.1.meta
/Assets/MonsterMutant 7/
/Assets/MonsterMutant 7.meta
/Assets/NewPunch/
/Assets/NewPunch.meta
/Assets/OccaSoftware/
/Assets/OccaSoftware.meta

# Extensiones de archivos 3D pesados / texturas fuente si no son esenciales
*.blend
*.max
*.ma
*.mb
*.psd
*.tga
*.raw

# Archivos 3D superiores a 100MB (Excluidos para GitHub)
**/Soldier.fbx
**/Soldier.fbx.meta
**/Ch35_nonPBR.fbx
**/Ch35_nonPBR.fbx.meta
